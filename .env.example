# --- Supabase (obrigatório) ---
# Públicas: embutidas no JS do navegador no momento do build (npm run build).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Servidor (SSR / server functions)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# SECRETA: nunca expor no navegador. Usada por pedidos, webhooks e repasses.
SUPABASE_SERVICE_ROLE_KEY=

# --- Asaas (pagamentos) ---
# Chave com "_prod_" usa a API de produção; qualquer outra usa o sandbox.
ASAAS_API_KEY=
# Mesmo valor configurado no webhook do Asaas (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=

# --- Firebase Cloud Messaging (notificações push, opcional) ---
VITE_FIREBASE_WEB_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# JSON da conta de serviço (Firebase > Configurações > Contas de serviço), em uma linha.
FIREBASE_SERVICE_ACCOUNT=

# --- Banco (só para rodar migrations com drizzle-kit; não precisa na Hostinger) ---
DATABASE_URL=

# --- Servidor Node ---
PORT=3000
